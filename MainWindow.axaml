<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MinRectangle.MainWindow"
        Title="АО4 — Прямокутник найменшої площі"
        Width="1060" Height="680"
        MinWidth="800" MinHeight="500"
        Background="#2b2b2b">

    <Grid ColumnDefinitions="220,*" Margin="0">

        <!-- ══ Ліва панель ══════════════════════════════ -->
        <Border Grid.Column="0" Background="#2b2b2b" Padding="10">
            <StackPanel Spacing="4">

                <TextBlock Text="Режим вводу"
                           FontWeight="Bold" FontSize="13"
                           Foreground="#eeeeee" Margin="0,0,0,4"/>

                <RadioButton x:Name="RbMouse"
                             Content="Мишою (до 100 точок)"
                             IsChecked="True"
                             Foreground="#cccccc" FontSize="12"/>

                <RadioButton x:Name="RbAuto"
                             Content="Автогенерація"
                             Foreground="#cccccc" FontSize="12"/>

                <TextBlock Text="Кількість точок (авто):"
                           Foreground="#aaaaaa" FontSize="11"
                           Margin="0,10,0,2"/>

                <TextBox x:Name="TbCount"
                         Text="10000"
                         IsEnabled="False"
                         Width="110" HorizontalAlignment="Left"
                         FontSize="12"/>

                <!-- Роздільник -->
                <Rectangle Height="1" Fill="#555555" Margin="0,10,0,6"/>

                <Button x:Name="BtnGenerate"
                        Content="⚙  Згенерувати точки"
                        IsEnabled="False"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Background="#3a6ea8" Foreground="White"
                        FontSize="12" Padding="6,8"/>

                <Button x:Name="BtnLoadFile"
                        Content="📂  Завантажити з файлу"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Background="#8e44ad" Foreground="White"
                        FontSize="12" Padding="6,8"/>

                <Button x:Name="BtnRun"
                        Content="▶  Запустити алгоритм"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Background="#27ae60" Foreground="White"
                        FontSize="12" Padding="6,8"/>

                <Button x:Name="BtnClear"
                        Content="✕  Очистити"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Background="#c0392b" Foreground="White"
                        FontSize="12" Padding="6,8"/>

                <!-- Роздільник -->
                <Rectangle Height="1" Fill="#555555" Margin="0,10,0,6"/>

                <TextBlock x:Name="LblPts"  Text="Точок: 0"    Foreground="#888888" FontSize="11"/>
                <TextBlock x:Name="LblHull" Text="Оболонка: —" Foreground="#888888" FontSize="11"/>
                <TextBlock x:Name="LblArea" Text="Площа: —"    Foreground="#888888" FontSize="11"/>
                <TextBlock x:Name="LblTime" Text="Час: —"       Foreground="#888888" FontSize="11"/>
                <TextBlock x:Name="LblFile" Text=""             Foreground="#666666" FontSize="10"
                           TextWrapping="Wrap"/>

            </StackPanel>
        </Border>

        <!-- ══ Полотно ════════════════════════════════════ -->
        <Border Grid.Column="1" Margin="0,8,8,8"
                Background="White" CornerRadius="4"
                ClipToBounds="True">
            <Canvas x:Name="DrawCanvas"
                    Background="White"/>
        </Border>

    </Grid>
</Window>
